# Inverter (driver: deye = Deye / Sunsynk with a Solarman Wi-Fi logger, the default)
# INVERTER_TYPE=deye
INVERTER_IP=192.168.1.100
LOGGER_SERIAL=1234567890

# Weather (coordinates for Open-Meteo API)
WEATHER_LATITUDE=50.4501
WEATHER_LONGITUDE=30.5234

# Inverter Capabilities (optional - auto-detected if not set)
# INVERTER_PHASES=3              # 1 for single-phase, 3 for three-phase
# INVERTER_HAS_BATTERY=true      # true or false
# INVERTER_PV_STRINGS=2          # 1 or 2
# INVERTER_HAS_GENERATOR=false   # true if generator connected to GEN/GRID2 port
# BATTERY_CAPACITY_KWH=10.24     # battery runtime estimate: use this instead of the capacity the inverter reports

# Generator (optional - only used when INVERTER_HAS_GENERATOR=true)
# GENERATOR_FUEL_RATE=2.5            # Fuel consumption in L/hour (0 to disable fuel tracking)
# GENERATOR_OIL_CHANGE_DATE=2025-01-15  # Last oil change date (YYYY-MM-DD)

# Outage Schedule Provider
# OUTAGE_PROVIDER=lvivoblenergo  # "lvivoblenergo", "yasno", "dtek", or "none" to disable
OUTAGE_GROUP=1.1

# YASNO provider settings (only used when OUTAGE_PROVIDER=yasno)
# OUTAGE_REGION_ID=25            # YASNO region (25 = Kyiv)
# OUTAGE_DSO_ID=902              # YASNO DSO (902 = DTEK Kyiv)
# OUTAGE_GROUP=2.1               # Queue/group number (1.1 - 6.2)

# DTEK provider settings (only used when OUTAGE_PROVIDER=dtek)
# Data from the community feed https://github.com/Baskerville42/outage-data-ua
# OUTAGE_DTEK_REGION=kyiv-region # "kyiv-region", "kyiv", "dnipro", or "odesa"
# OUTAGE_GROUP=4.2               # Queue/group number (1.1 - 6.2)

# Air raid alerts map. Data from alerts.in.ua (token from https://devs.alerts.in.ua/, kept on
# the server) or NEPTUN (https://neptun.in.ua, no key needed).
# AIR_ALERTS_PROVIDER: "alerts_in_ua", "neptun", "mock" (demo data) or "none" (hide the card);
# empty = alerts_in_ua when a token is set, else neptun
# AIR_ALERTS_PROVIDER=alerts_in_ua
# ALERTS_IN_UA_TOKEN=your-token
# AIR_ALERTS_REGION=UA-32       # map shows only this region (UA-32 = Kyiv oblast + Kyiv); empty = whole Ukraine

# Smart electricity meter (Bakler, MQTT). docker compose runs a Mosquitto broker on port 1883;
# point the meter (app: Settings -> Integration -> MQTT) at this machine's IP with the same user/password.
# The broker isn't reachable from the network until user and password are set.
# SMART_METER_ENABLED=true
# SMART_METER_MQTT_USER=meter
# SMART_METER_MQTT_PASSWORD=choose-a-long-password
# SMART_METER_MQTT_HOST=mosquitto   # another broker; default "mosquitto" in Docker, else "localhost"
# SMART_METER_MQTT_PORT=1883
# SMART_METER_SERIAL=               # pick one meter when several publish to the broker
# SMART_METER_INTERVAL=10           # update interval requested from the meter, 1-60 s (0 = don't change)
# SMART_METER_SWITCH_ON_DELAY=120   # the meter's switch-on delay after an outage (its app's setting), s: that wait counts as part of the outage
# SMART_METER_DEMO=3                # simulated meter to preview the card: 1 = single-phase, 3 = three-phase

# Settings PIN (asked when opening the settings panel; default 0000)
# SETTINGS_PIN=0000

# Name at the top of the page and in the browser tab (up to 40 characters, no # " ' \);
# empty = "Home energy" in the dashboard's language
# DASHBOARD_TITLE=Дача Іванових

# Telegram Bot (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_USERS=123456789,987654321
# Set to true to allow any user to query the bot (broadcasts still go to ALLOWED_USERS only)
TELEGRAM_PUBLIC=false

# Deployment (used by deploy.sh)
DEPLOY_HOST=192.168.1.100
DEPLOY_USER=youruser
DEPLOY_DIR=/home/youruser/inverter-dashboard
DEPLOY_SERVICE_NAME=inverter-dashboard


# Optional: data file paths. By default every data file lives in data/ (in Docker the
# mounted volume, so it survives updates); a relative path here would put it next to
# the app instead and lose it on every rebuild
# PHASE_STATS_FILE=data/phase_stats.json
